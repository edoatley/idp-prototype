{
  "name": "idp-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Thin custom IDP portal \u2014 the HTML surface over idp-core (create-bucket form, inventory, oversight dashboard).",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "express-openapi-validator": "^5.6.2",
    "idp-core": "*"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11"
  }
}
