{
  "name": "idp-cli",
  "version": "0.1.0",
  "private": true,
  "description": "The IDP command line — the same golden path as the portal, from a terminal or a pipeline.",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "idp": "bin/idp.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate": "openapi-typescript ../contracts/openapi.yaml -o src/schema.d.ts",
    "start": "tsx src/main.ts"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "js-yaml": "^4.1.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "openapi-typescript": "^7.4.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11"
  }
}
